# 검색 (없으면 자동 offline: data/fixtures 사용) — https://tavily.com 무료 키
TAVILY_API_KEY=

# LLM: anthropic | gemini | openai | none   (none 이면 규칙 기반으로 대체)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# 메일 (Gmail: 2단계 인증 후 '앱 비밀번호' 발급)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=

# 안전장치: 1 이면 실제 발송하지 않고 outbox/ 에 미리보기만 저장
DRY_RUN=1
MIN_ITEMS=3
MAX_ATTEMPTS=2
TOPIC=AI
